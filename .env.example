NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin privado (/admin). Use pelo menos um deles.
ADMIN_EMAILS=seu-email@exemplo.com
ADMIN_UIDS=

# Conta de serviço "love-garden-server" (papel Cloud Datastore User) para as APIs server-side.
# Valor: o JSON da chave em base64 (`base64 -w0 sa.json`). O project_id é lido da própria chave.
# Alternativas aceitas: FIREBASE_SERVICE_ACCOUNT (JSON puro) ou FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Mercado Pago Checkout Pro.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_URL=
MERCADO_PAGO_CHECKOUT_URL_MODE=sandbox

